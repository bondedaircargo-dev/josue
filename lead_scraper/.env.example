# Anthropic API Key (para AI Enrichment)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Google Search API (opcional - usar SerpAPI o Google Custom Search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI (alternativa gratuita hasta 100 busquedas/mes)
SERPAPI_KEY=

# Configuracion general
LOG_LEVEL=INFO
DB_PATH=data/leads.db
EXPORTS_PATH=data/exports/

# Delays entre requests (segundos)
DELAY_MIN=2
DELAY_MAX=5

# Maximo de URLs a scrapear por busqueda
MAX_URLS_PER_SEARCH=10

# Usar AI enrichment automatico (true/false)
AUTO_AI_ENRICHMENT=false
