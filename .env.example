# Token de acceso de la app de Meta (WhatsApp Cloud API)
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# ID del número de teléfono registrado en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Token secreto que tú defines para verificar el webhook en Meta
WEBHOOK_VERIFY_TOKEN=my_custom_verify_token

# Puerto del servidor (opcional, default 3000)
PORT=3000

# ═══════════════════════════════════════════════════════════════
#  Lead Finder & Email Automation — Bonded Air Cargo
# ═══════════════════════════════════════════════════════════════

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# For Gmail: use an App Password (not your account password)
# Enable 2FA then create App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=info@bondedaircargo.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_NAME=Bonded Air Cargo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Max emails per run (recommended: 30–50 to stay under spam thresholds)
EMAIL_BATCH_SIZE=30

# ── Optional APIs ─────────────────────────────────────────────────────────────

# SerpAPI — reliable Google results (100 free searches/month)
# Sign up at: https://serpapi.com
SERPAPI_KEY=

# Hunter.io — discover emails by company domain (25 free/month)
# Sign up at: https://hunter.io
HUNTER_API_KEY=

# ── Google Sheets export (optional) ──────────────────────────────────────────
# Set to "true" to auto-export leads to Google Sheets after each scrape
GSHEETS_ENABLED=false

# Path to Google service account credentials JSON
# Download from: Google Cloud Console → IAM → Service Accounts
GSHEETS_CREDENTIALS=credentials.json

# Name of the Google Sheet to create/update
GSHEETS_SPREADSHEET=Leads - Bonded Air Cargo
