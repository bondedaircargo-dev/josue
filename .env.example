# ============================================================
# BONDED AIR CARGO - AUTOMATION SYSTEM
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# --- SERVER ---
PORT=3000

# --- COMPANY INFO ---
COMPANY_NAME=Bonded Air Cargo
COMPANY_PHONE=+13050000000

# ============================================================
# WHATSAPP BUSINESS CLOUD API (Meta for Developers)
# https://developers.facebook.com/apps/
# ============================================================
# Access token from your Meta App > WhatsApp > API Setup
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Phone Number ID from Meta App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Secret token you define - must match what you enter in Meta webhook config
WEBHOOK_VERIFY_TOKEN=my_bonded_verify_token_2024

# ============================================================
# META ADS API (Facebook/Instagram Ads)
# https://developers.facebook.com/apps/
# ============================================================
# System User Access Token with ads_management permission
META_ADS_TOKEN=your_meta_ads_token_here

# Your Ad Account ID (without "act_" prefix)
# Found at: business.facebook.com > Ad Accounts
META_ADS_ACCOUNT_ID=your_ad_account_id_here

# Meta App ID and Secret (for webhook signature verification)
META_APP_SECRET=your_meta_app_secret_here

# ============================================================
# ANTHROPIC / CLAUDE AI
# https://console.anthropic.com/
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ============================================================
# GMAIL (for sending invoices, tracking emails)
# Use Gmail App Password (not your regular password)
# https://myaccount.google.com/apppasswords
# ============================================================
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ============================================================
# GOOGLE SHEETS (for logging shipments, customers, leads)
# https://console.cloud.google.com/
# Create a Service Account and share your sheets with it
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com

# The private key from your Service Account JSON (keep \n as literal \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheet IDs (the long ID in the sheet URL)
GOOGLE_SHEET_SHIPMENTS_ID=your_shipments_sheet_id
GOOGLE_SHEET_CUSTOMERS_ID=your_customers_sheet_id
GOOGLE_SHEET_LEADS_ID=your_leads_sheet_id
GOOGLE_SHEET_MESSAGES_ID=your_messages_sheet_id
