# Token de acceso de la app de Meta (WhatsApp Cloud API)
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# ID del número de teléfono registrado en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Token secreto que tú defines para verificar el webhook en Meta
WEBHOOK_VERIFY_TOKEN=my_custom_verify_token

# Puerto del servidor (opcional, default 3000)
PORT=3000
