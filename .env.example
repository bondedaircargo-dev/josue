# ============================================================
# VORTEX GROUP — AI OPERATIONS SYSTEM v3.0
# Copia este archivo: cp .env.example .env
# Nunca subas .env a git
# ============================================================

# --- SERVIDOR ---
PORT=3000

# ============================================================
# WHATSAPP BUSINESS CLOUD API — POR EMPRESA
# developers.facebook.com → Tu App → WhatsApp → API Setup
# ============================================================

# Token de verificación (tú lo inventas, debe coincidir en Meta Webhooks)
VERIFY_TOKEN=mi_token_seguro_vortex

# ── MCPack / EGA (número principal) ──────────────────────────
MCP_PHONE_NUMBER_ID=123456789
MCP_WA_TOKEN=EAAxxxxx_mcpack_token

# ── GoPack ───────────────────────────────��───────────────────
GPK_PHONE_NUMBER_ID=234567890
GPK_WA_TOKEN=EAAxxxxx_gopack_token

# ── One Courier ──────────────────────────────────────────────
ONE_PHONE_NUMBER_ID=345678901
ONE_WA_TOKEN=EAAxxxxx_one_courier_token

# ── Vortex (premium) ─────────────────────────────────────────
VTX_PHONE_NUMBER_ID=456789012
VTX_WA_TOKEN=EAAxxxxx_vortex_token

# Fallback (si solo tienes 1 número por ahora)
PHONE_NUMBER_ID=123456789
WHATSAPP_TOKEN=EAAxxxxx_tu_token_aqui
BUSINESS_ACCOUNT_ID=123456789

# ============================================================
# ANTHROPIC / CLAUDE AI
# console.anthropic.com → API Keys
# ============================================================
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# ============================================================
# META ADS API
# business.facebook.com → System Users → Generar token
# ============================================================
META_ADS_TOKEN=tu_meta_ads_token
META_ADS_ACCOUNT_ID=tu_ad_account_id

# ============================================================
# GMAIL
# Usar App Password (no contraseña normal)
# myaccount.google.com/apppasswords
# ============================================================
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_16_chars

# Por empresa (opcional)
MCP_EMAIL=mcpack@empresa.com
GPK_EMAIL=gopack@empresa.com
ONE_EMAIL=onecourier@empresa.com
VTX_EMAIL=vortex@empresa.com

# ============================================================
# GOOGLE SHEETS (Service Account)
# console.cloud.google.com → Service Account → clave JSON
# Comparte cada Sheet con el email de la Service Account
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"

GOOGLE_SHEET_SHIPMENTS_ID=id_sheet_envios
GOOGLE_SHEET_CUSTOMERS_ID=id_sheet_clientes
GOOGLE_SHEET_LEADS_ID=id_sheet_leads
GOOGLE_SHEET_MESSAGES_ID=id_sheet_mensajes

# ============================================================
# PAGOS
# ============================================================
PAYMENT_ZELLE=pagos@empresa.com
PAYMENT_CASH_APP=$tuempresa

# ============================================================
# AGENTES (teléfonos para notificaciones internas)
# ============================================================
AGENT_1_PHONE=13051234567
AGENT_2_PHONE=13059876543
AGENT_3_PHONE=13055551234

# ============================================================
# EMPRESA (legacy — usado en templates)
# ============================================================
COMPANY_NAME=Bonded Air Cargo
COMPANY_PHONE=+13050000000
