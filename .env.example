# ============================================================
# BONDED AIR CARGO - AUTOMATION SYSTEM
# Copia este archivo: cp .env.example .env
# Nunca subas .env a git
# ============================================================

# --- SERVIDOR ---
PORT=3000

# --- EMPRESA ---
COMPANY_NAME=Bonded Air Cargo
COMPANY_PHONE=+13050000000

# ============================================================
# WHATSAPP BUSINESS CLOUD API
# developers.facebook.com → Tu App → WhatsApp → API Setup
# ============================================================
WHATSAPP_TOKEN=EAAxxxxx_tu_token_aqui

# Phone Number ID (en Meta: WhatsApp > API Setup)
PHONE_NUMBER_ID=123456789

# WhatsApp Business Account ID
BUSINESS_ACCOUNT_ID=123456789

# Token que TÚ inventas — debe coincidir con el que pones en Meta Webhooks
VERIFY_TOKEN=mi_token_seguro

# ============================================================
# ANTHROPIC / CLAUDE AI
# console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# ============================================================
# META ADS API (Facebook/Instagram Ads)
# business.facebook.com → System Users → Generar token
# ============================================================
META_ADS_TOKEN=tu_meta_ads_token
META_ADS_ACCOUNT_ID=tu_ad_account_id

# ============================================================
# GMAIL
# Usar App Password (no tu contraseña normal)
# myaccount.google.com/apppasswords
# ============================================================
GMAIL_USER=tu_email@gmail.com
GMAIL_APP_PASSWORD=tu_app_password_16_chars

# ============================================================
# GOOGLE SHEETS
# console.cloud.google.com → Service Account → clave JSON
# Comparte cada Sheet con el email de la Service Account
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"

GOOGLE_SHEET_SHIPMENTS_ID=id_de_tu_sheet_envios
GOOGLE_SHEET_CUSTOMERS_ID=id_de_tu_sheet_clientes
GOOGLE_SHEET_LEADS_ID=id_de_tu_sheet_leads
GOOGLE_SHEET_MESSAGES_ID=id_de_tu_sheet_mensajes
